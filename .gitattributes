# Windows-first repository.
# cmd.exe and Windows PowerShell are most reliable with CRLF; web sources stay LF.
* text=auto

*.bat     text eol=crlf
*.ps1     text eol=crlf
*.iss     text eol=crlf
*.isl     text eol=crlf
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.config  text eol=crlf

*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf

# GitHub metadata (issue forms, workflows) must stay LF: workflows are parsed on
# Linux runners and CRLF inside block scalars is easy to get wrong.
.github/**  text eol=lf
*.yml       text eol=lf

*.dll     binary
*.exe     binary
*.ico     binary
*.png     binary
*.zip     binary
*.db      binary
